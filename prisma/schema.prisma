// AutoAlert Prisma Schema
// Source of truth: docs/05-DATABASE.md, docs/06-ERD.md, docs/04-BUSINESS_RULES.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  owner
  mechanic

  @@map("user_role")
}

enum MaintenanceType {
  oil_change
  filter_change
  brake_change
  tire_change
  battery_change
  tune_up
  general_repair

  @@map("maintenance_type")
}

enum OperatingExpenseType {
  fuel
  insurance
  registration

  @@map("operating_expense_type")
}

enum AlertKind {
  maintenance_date
  maintenance_mileage
  insurance_expiry
  registration_expiry

  @@map("alert_kind")
}

enum AlertStatus {
  pending
  read
  sent
  failed

  @@map("alert_status")
}

enum AlertChannel {
  in_app
  email
  whatsapp

  @@map("alert_channel")
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Profile {
  id    String @id @default(uuid()) @db.Uuid
  email String @unique

  fullName     String   @db.VarChar(120)
  phone        String?  @db.VarChar(30)
  role         UserRole @default(owner)
  currencyCode String   @default("HNL") @db.Char(3)

  emailAlertsEnabled    Boolean @default(true)
  whatsappAlertsEnabled Boolean @default(false)

  dateLeadDays       Int @default(15)
  mileageThresholdKm Int @default(300)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  vehicles           Vehicle[]
  workshops          Workshop[]
  mileageLogs        MileageLog[]
  maintenanceRecords MaintenanceRecord[]
  operatingExpenses  OperatingExpense[]
  alerts             Alert[]

  @@map("profiles")
}

model Vehicle {
  id        String    @id @default(uuid()) @db.Uuid
  ownerId   String    @map("owner_id") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  plate           String  @db.VarChar(20)
  normalizedPlate String  @map("normalized_plate") @db.VarChar(20)
  make            String  @db.VarChar(80)
  model           String  @db.VarChar(80)
  year            Int
  vin             String? @unique @db.VarChar(17)
  currentMileage  Int     @default(0) @map("current_mileage")
  fuelType        String  @map("fuel_type") @db.VarChar(30)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  owner              Profile             @relation(fields: [ownerId], references: [id])
  vehicleWorkshops   VehicleWorkshop[]
  mileageLogs        MileageLog[]
  maintenanceRecords MaintenanceRecord[]
  operatingExpenses  OperatingExpense[]
  alerts             Alert[]

  @@unique([ownerId, normalizedPlate])
  @@index([ownerId])
  @@index([normalizedPlate])
  @@map("vehicles")
}

model Workshop {
  id         String    @id @default(uuid()) @db.Uuid
  mechanicId String    @map("mechanic_id") @db.Uuid
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz()

  name    String  @db.VarChar(120)
  address String? @db.VarChar(255)
  phone   String? @db.VarChar(30)
  manager String? @db.VarChar(120)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  mechanic           Profile             @relation(fields: [mechanicId], references: [id])
  vehicleWorkshops   VehicleWorkshop[]
  maintenanceRecords MaintenanceRecord[]

  @@index([mechanicId])
  @@map("workshops")
}

model VehicleWorkshop {
  id         String  @id @default(uuid()) @db.Uuid
  vehicleId  String  @map("vehicle_id") @db.Uuid
  workshopId String  @map("workshop_id") @db.Uuid
  active     Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id])
  workshop Workshop @relation(fields: [workshopId], references: [id])

  @@unique([vehicleId, workshopId])
  @@index([vehicleId])
  @@index([workshopId])
  @@map("vehicle_workshops")
}

model MileageLog {
  id         String @id @default(uuid()) @db.Uuid
  vehicleId  String @map("vehicle_id") @db.Uuid
  recorderId String @map("recorder_id") @db.Uuid

  mileage Int
  date    DateTime @db.Date
  note    String?  @db.VarChar(1000)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  vehicle  Vehicle @relation(fields: [vehicleId], references: [id])
  recorder Profile @relation(fields: [recorderId], references: [id])

  @@index([vehicleId])
  @@index([recorderId])
  @@index([date])
  @@map("mileage_logs")
}

model MaintenanceRecord {
  id         String    @id @default(uuid()) @db.Uuid
  vehicleId  String    @map("vehicle_id") @db.Uuid
  workshopId String?   @map("workshop_id") @db.Uuid
  creatorId  String    @map("creator_id") @db.Uuid
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz()

  type        MaintenanceType
  mileage     Int
  serviceDate DateTime        @map("service_date") @db.Date
  description String?         @db.VarChar(1000)

  costTotal Decimal? @map("cost_total") @db.Decimal(12, 2)
  costLabor Decimal? @map("cost_labor") @db.Decimal(12, 2)
  costParts Decimal? @map("cost_parts") @db.Decimal(12, 2)

  nextServiceDate    DateTime? @map("next_service_date") @db.Date
  nextServiceMileage Int?      @map("next_service_mileage")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  vehicle  Vehicle   @relation(fields: [vehicleId], references: [id])
  workshop Workshop? @relation(fields: [workshopId], references: [id])
  creator  Profile   @relation(fields: [creatorId], references: [id])

  @@index([vehicleId])
  @@index([workshopId])
  @@index([creatorId])
  @@index([serviceDate])
  @@index([nextServiceDate])
  @@index([nextServiceMileage])
  @@map("maintenance_records")
}

model OperatingExpense {
  id        String    @id @default(uuid()) @db.Uuid
  vehicleId String    @map("vehicle_id") @db.Uuid
  creatorId String    @map("creator_id") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  type   OperatingExpenseType
  amount Decimal              @db.Decimal(12, 2)
  date   DateTime             @db.Date
  notes  String?              @db.VarChar(1000)

  // Fuel-specific
  fuelQuantity Decimal? @map("fuel_quantity") @db.Decimal(10, 2)
  fuelUnit     String?  @map("fuel_unit") @db.VarChar(10)
  fuelStation  String?  @map("fuel_station") @db.VarChar(120)
  fuelAddress  String?  @map("fuel_address") @db.VarChar(255)

  // Insurance / Registration
  dueDate    DateTime? @map("due_date") @db.Date
  termMonths Int?      @map("term_months")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  creator Profile @relation(fields: [creatorId], references: [id])

  @@index([vehicleId])
  @@index([creatorId])
  @@index([type])
  @@index([dueDate])
  @@index([date])
  @@map("operating_expenses")
}

model Alert {
  id             String  @id @default(uuid()) @db.Uuid
  recipientId    String  @map("recipient_id") @db.Uuid
  vehicleId      String  @map("vehicle_id") @db.Uuid
  // Polymorphic FK: references either maintenance_records or operating_expenses.
  // Enforced by RLS + application logic, not Prisma @relation.
  sourceRecordId String? @map("source_record_id") @db.Uuid
  sourceType     String? @map("source_type") @db.VarChar(40)

  kind    AlertKind
  channel AlertChannel @default(in_app)
  status  AlertStatus  @default(pending)

  title      String    @db.VarChar(200)
  message    String    @db.VarChar(1000)
  dueDate    DateTime? @map("due_date") @db.Date
  dueMileage Int?      @map("due_mileage")

  sentAt      DateTime? @map("sent_at") @db.Timestamptz()
  readAt      DateTime? @map("read_at") @db.Timestamptz()
  errorDetail String?   @map("error_detail") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  recipient Profile @relation(fields: [recipientId], references: [id])
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  @@unique([sourceRecordId, recipientId, channel])
  @@index([recipientId])
  @@index([vehicleId])
  @@index([sourceRecordId])
  @@index([kind])
  @@index([status])
  @@index([dueDate])
  @@map("alerts")
}
